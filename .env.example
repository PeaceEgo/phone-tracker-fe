# Same-origin API proxy (src/app/backend/[...path]/route.ts → BACKEND_URL)
NEXT_PUBLIC_API_URL=/backend/api

# WebSocket origin for Socket.IO (direct to backend)
NEXT_PUBLIC_WS_URL=wss://phone-tracker-be.onrender.com

# Public HTTPS FE origin for QR links (match backend PUBLIC_APP_URL)
NEXT_PUBLIC_APP_URL=https://phone-tracker-fe.vercel.app

# Server-only: upstream API used by /backend/* route proxy
BACKEND_URL=https://phone-tracker-be.onrender.com
